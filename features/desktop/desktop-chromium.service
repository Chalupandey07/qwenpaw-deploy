[Unit]
Description=Desktop Chromium on display :1 (wordsolverx.com)
After=network.target

[Service]
Type=simple
User=user
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/chromium --no-sandbox --disable-dev-shm-usage --start-maximized --window-size=1920,1048 --window-position=0,0 --no-first-run https://wordsolverx.com
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
