[Unit]
Description=websockify for the /desktop terminal tab (PTY server)
After=network.target desktop-terminal.service

[Service]
Type=simple
User=user
ExecStart=/usr/bin/websockify --web /usr/share/novnc 127.0.0.1:6083 --unix-target=/run/user/1000/terminal.sock
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
