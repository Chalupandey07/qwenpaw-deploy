[Unit]
Description=View-only VNC (x11vnc) for built-in desktop display :1
After=network.target

[Service]
Type=simple
User=user
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/x11vnc -display :1 -forever -shared -viewonly -nopw -rfbport 5902 -localhost -o /tmp/x11vnc-view.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
