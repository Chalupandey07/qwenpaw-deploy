[Unit]
Description=View-only VNC (x11vnc) for QA display :2
After=network.target desktop-xvfb-qa.service

[Service]
Type=simple
User=user
Environment=DISPLAY=:2
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/x11vnc -display :2 -forever -shared -viewonly -nopw -rfbport 5903 -localhost -o /tmp/x11vnc-qa-view.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
