[Unit]
Description=xfwm4 window manager for display :2
After=network.target desktop-xvfb-qa.service desktop-dbus-qa.service

[Service]
Type=simple
User=user
Environment=DISPLAY=:2
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/qa/bus
ExecStart=/usr/bin/xfwm4 --display=:2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
