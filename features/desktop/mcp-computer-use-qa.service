[Unit]
Description=MCP proxy: computer-use MCP for the QA-agent display :2 (port 8897)
After=network.target desktop-dbus-qa.service

[Service]
Type=simple
User=user
ExecStartPre=/bin/mkdir -p /run/user/1000/qa
ExecStart=/data/home/mcp-proxy/venv/bin/mcp-proxy --host 172.18.0.1 --port 8897 -- /data/home/mcp-proxy/qa-server.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
