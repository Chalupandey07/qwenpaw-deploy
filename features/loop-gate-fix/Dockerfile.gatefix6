# Derived QwenPaw image with the loop-gate fix, round 6 (gatefix6).
#
# Base is the LIVE image qwenpaw-agentx:2.3.0-gatefix5 (upstream +
# gatefix4 + bloat-winwin + cost-ledger + Telegram + gatefix5
# persistence), so all of those layers survive. The only change is
# the gatefix6 delta: the task-identity heuristic _is_continuation
# in limits.py now matches a continuation phrase at the START of
# the message at a word boundary, not just an exact match. Gatefix5
# persisted the task budget correctly (proven by the live session
# file), but its exact-match rule treated realistic resume messages
# ("hello, are you working?", "Yes, continue from 21") as new
# instructions, minting a fresh task budget each time -- so the
# per-task cap never accumulated across turns (live: 20 shell/turn,
# cumulative 60, past the 40-shell cap). Nothing else is changed.
# Tag: qwenpaw-agentx:2.3.0-gatefix6.
FROM qwenpaw-agentx:2.3.0-gatefix5

COPY qwenpaw-loop-gate-fix6.patch /tmp/qwenpaw-loop-gate-fix6.patch

# Apply the gatefix6 delta in BOTH places the code lives. The package is
# installed in site-packages (that is what Python imports at runtime);
# /app/src is the source tree the install was built from. Both copies
# are byte-identical, so the same patch applies to both: -p1 from /app
# patches src/qwenpaw/..., -p2 from site-packages patches qwenpaw/....
# Then byte-compile the patched module so a stale .pyc can never win.
# The build FAILS here if the patch does not apply cleanly to either copy.
RUN cd /app \
    && patch -p1 < /tmp/qwenpaw-loop-gate-fix6.patch \
    && cd /app/venv/lib/python3.11/site-packages \
    && patch -p2 < /tmp/qwenpaw-loop-gate-fix6.patch \
    && rm /tmp/qwenpaw-loop-gate-fix6.patch \
    && python3 -m py_compile \
        /app/src/qwenpaw/loop/gates/limits.py \
        /app/venv/lib/python3.11/site-packages/qwenpaw/loop/gates/limits.py
