[Unit]
Description=TigerVNC X server :99 for Camoufox watchable screen
After=network.target

[Service]
Type=simple
User=user
ExecStart=/usr/bin/Xvnc :99 -geometry 1920x1080 -depth 24 -rfbauth /data/home/camoufox/.vnc/passwd -localhost -nolisten tcp -AlwaysShared
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
