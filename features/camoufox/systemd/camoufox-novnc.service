[Unit]
Description=noVNC (websockify) for Camoufox VNC display :99
After=camoufox-vnc.service
Wants=camoufox-vnc.service

[Service]
Type=simple
User=user
ExecStart=/usr/bin/websockify --web /usr/share/novnc 127.0.0.1:6080 127.0.0.1:5999
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
