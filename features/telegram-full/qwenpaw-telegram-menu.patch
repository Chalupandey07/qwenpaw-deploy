+    async def _handle_menu_callback(self, query):
+        """Route a Telegram menu tap to the agent.
+
+        Upstream drops every non-approval callback silently. A tap
+        whose data matches the menu grammar (``ui:`` / ``act:``, see
+        cards/menu.py — the byte-identical copy of
+        features/telegram-full/menu.py) is admitted as a callback
+        event with the text ``/tgmenu <payload>`` so the agent (with
+        the ``telegram`` skill) can route it through
+        features/telegram-full/tg.py. Anything else is still dropped,
+        exactly as before. The spinner is always cleared first.
+        """
+        from .cards.menu import valid_callback
+
+        data = query.data or ""
+        if not valid_callback(data):
+            return
+        try:
+            await query.answer()
+        except Exception:
+            logger.debug("Telegram menu callback toast failed")
+        message, actor = query.message, query.from_user
+        chat_id = str(message.chat.id) if message is not None else ""
+        sender_id = str(actor.id) if actor is not None else chat_id
+        meta = {
+            "chat_id": chat_id,
+            "user_id": sender_id,
+            "message_thread_id": (
+                message.message_thread_id if message is not None else None
+            ),
+            "is_group": bool(message is not None
+                             and message.chat.type != "private"),
+            "username": ((actor.username or actor.first_name or sender_id)
+                         if actor is not None else sender_id),
+            "bot_mentioned": True,
+            "has_bot_command": True,
+        }
+        await self.on_callback(
+            {
+                "event_id": "callback:" + query.id,
+                "event_kind": "callback",
+                "sender_id": sender_id,
+                "acl_sender_id": sender_id,
+                "user_id": sender_id,
+                "session_id": "telegram:" + chat_id,
+                "meta": meta,
+                "content_parts": [
+                    {"type": "text", "text": "/tgmenu " + data},
+                ],
+            },
+        )
 
