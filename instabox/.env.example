# Copy to .env on the InstaBox machine, edit, then: chmod 600 .env
# NEVER commit a real .env to GitHub.

# --- Auth: set BEFORE first boot ---
QWENPAW_AUTH_ENABLED=true
QWENPAW_AUTH_USERNAME=admin
QWENPAW_AUTH_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# --- Telemetry / China-free ---
QWENPAW_TELEMETRY_DISABLED=true
QWENPAW_CHANNEL_PRESET=light
QWENPAW_DISABLED_CHANNELS=dingtalk,feishu,wechat,qq,wecom,yuanbao,xiaoyi,imessage

# --- Hardening ---
QWENPAW_TOOL_GUARD_ENABLED=true
QWENPAW_SKILL_SCAN_MODE=block

# --- Port (default 8088; do not change without updating publish + Worker) ---
QWENPAW_PORT=8088

# --- Language / timezone (English only) ---
# NOTE: there is no QWENPAW_LANGUAGE env var in the image. The agent
# language lives in working/config.json (agents.language=en) and the
# workspace templates (SOUL.md / PROFILE.md / MEMORY.md / AGENTS.md).
# These env vars only set the container locale/timezone.
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
TZ=Asia/Kolkata

# --- DO NOT SET ---
# DASHSCOPE_API_KEY  <- China default, do not set
# OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY / DEEPSEEK_API_KEY / OPENROUTER_API_KEY
#   <- NOT documented as natively read by QwenPaw. Configure keys in
#      Console > Settings > Models (stored encrypted in providers.json
#      in the secrets volume).
# No local-model / Ollama / LM Studio / QwenPaw-Flash config.
